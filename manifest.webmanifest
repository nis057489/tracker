    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Track today", "url": "./index.html#/track" },
    { "name": "Insights", "url": "./index.html#/insights" }
