{
  "name": "Time Tracker",
  "short_name": "Tracker",
  "description": "Track how much time you spend on daily activities, and watch the pattern over years.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
